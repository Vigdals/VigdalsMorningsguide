@using System.Globalization
@model VigdalsMorningsguide.Models.MorningPageViewModel

@{
    ViewData["Title"] = "Vigdals mørningsguide";

    var displayedHungDate = Model.Input.HungDate.ToString(
        "dd.MM.yyyy",
        CultureInfo.InvariantCulture);
}

<div class="container py-4 py-lg-5">
    <header class="guide-header mb-4 mb-lg-5">
        <h1 class="display-5 fw-bold mb-3">
            Vigdals mørningsguide
        </h1>

        <p class="lead text-body-secondary mb-0">
            Følg mørninga av viltkjøtet ditt.
        </p>
    </header>

    <section class="card guide-card mb-4" aria-labelledby="input-heading">

        <div class="guide-card-header">
            <h2 id="input-heading" class="h4 mb-0">
                Registrer opphengstidspunkt og døgngrader
            </h2>
        </div>

        <div class="guide-card-body">
            <form asp-action="Index" asp-controller="Morning" method="post" id="maturation-form">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                </div>

                <div class="row g-4 align-items-start">
                    <div class="col-md-6 col-lg-4">
                        <label for="hung-date-display" class="form-label fw-semibold">
                            Dato
                        </label>

                        <input asp-for="Input.HungDate" type="hidden" id="hung-date-value" />

                        <input id="hung-date-display" type="text" class="form-control form-control-lg"
                               value="@displayedHungDate" placeholder="dd.mm.åååå" inputmode="numeric" autocomplete="off"
                               maxlength="10" aria-describedby="hung-date-help hung-date-client-error"
                               aria-invalid="false" />

                        <span asp-validation-for="Input.HungDate" class="text-danger small">
                        </span>

                        <div id="hung-date-client-error" class="text-danger small mt-1" role="alert" hidden>
                        </div>

                        <div id="hung-date-help" class="form-text">
                            Norsk datoformat
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label asp-for="Input.HungTime" class="form-label fw-semibold">
                        </label>

                        <input id="hung-time" name="Input.HungTime" type="text" class="form-control form-control-lg"
                               value="@Model.Input.HungTime.ToString("HH:mm")" placeholder="TT:mm" inputmode="numeric"
                               autocomplete="off" maxlength="5" aria-describedby="hung-time-help hung-time-client-error"
                               aria-invalid="false" />

                        <span asp-validation-for="Input.HungTime" class="text-danger small">
                        </span>

                        <div id="hung-time-client-error" class="text-danger small mt-1" role="alert" hidden>
                        </div>

                        <div id="hung-time-help" class="form-text">
                            24-timarsformat
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-2">
                        <label asp-for="Input.TargetDegreeDays" class="form-label fw-semibold">
                        </label>

                        <div class="input-group input-group-lg">
                            <input asp-for="Input.TargetDegreeDays" type="number" class="form-control" min="1" max="300"
                                   step="1" inputmode="numeric" aria-describedby="target-degree-days-help" />

                            <span class="input-group-text">
                                DG
                            </span>
                        </div>

                        <span asp-validation-for="Input.TargetDegreeDays" class="text-danger small">
                        </span>

                        <div id="target-degree-days-help" class="form-text">
                            Min gullstandard er 80.
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label class="form-label d-none d-lg-block" aria-hidden="true">
                            &nbsp;
                        </label>

                        <button type="submit" class="btn btn-primary btn-lg w-100 calculate-button">
                            Rekn ut døgngrader
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    @if (Model.Result is not null)
    {
        var result = Model.Result;

        var progressWidth = result.ProgressPercent.ToString(
            "0.0",
            CultureInfo.InvariantCulture);

        string? estimatedTimeText = null;

        if (result.EstimatedHoursRemaining is double estimatedHours)
        {
            var roundedHours = Math.Max(
                0,
                (int)Math.Round(estimatedHours));

            var estimatedDays = roundedHours / 24;
            var estimatedRemainingHours = roundedHours % 24;

            estimatedTimeText = estimatedDays switch
            {
                > 0 when estimatedRemainingHours > 0 =>
                    $"{estimatedDays} døgn og {estimatedRemainingHours} timar",

                > 0 =>
                    $"{estimatedDays} døgn",

                _ when estimatedRemainingHours > 0 =>
                    $"{estimatedRemainingHours} timar",

                _ =>
                    "Under éin time"
            };
        }

        <section class="card guide-card mb-4" aria-labelledby="result-heading">

            <div class="guide-card-header d-flex flex-column flex-md-row
                justify-content-between align-items-md-center gap-3">

                <div>
                    <h2 id="result-heading" class="h4 mb-1">
                        Status for mørninga
                    </h2>

                    <p class="text-body-secondary mb-0">
                        Rekna fram til
                        @result.CalculatedAt.ToString(
                            "dd.MM.yyyy 'kl.' HH:mm")
                    </p>
                </div>

                @if (result.TargetReached)
                {
                    <span class="badge rounded-pill text-bg-success fs-6">
                        Målet er nådd
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-primary fs-6">
                        @result.ProgressPercent.ToString("0") % fullført
                    </span>
                }
            </div>

            <div class="guide-card-body">
                @if (result.TargetReached)
                {
                    <div class="remaining-time-card remaining-time-card-complete mb-4" role="status">

                        <div class="remaining-time-label">
                            Status
                        </div>

                        <div class="remaining-time-value">
                            Målet er nådd
                        </div>

                        <p class="remaining-time-description mb-0">
                            Slaktet har passert målet på
                            @result.TargetDegreeDays.ToString("0")
                            døgngrader.
                        </p>
                    </div>
                }
                else if (estimatedTimeText is not null)
                {
                    <div class="remaining-time-card mb-4" role="status" aria-label="Estimert tid att til døgngradmålet">

                        <div class="remaining-time-label">
                            Estimert tid att
                        </div>

                        <div class="remaining-time-value">
                            @estimatedTimeText
                        </div>

                        <p class="remaining-time-description mb-0">
                            Med same gjennomsnittstemperatur som fram til no.
                        </p>
                    </div>
                }

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="summary-card">
                            <div class="summary-label">
                                Døgngrader
                            </div>

                            <div class="summary-value">
                                @result.TotalDegreeDays.ToString("0.0")

                                <span class="summary-target">
                                    / @result.TargetDegreeDays.ToString("0")
                                </span>
                            </div>

                            <div class="summary-subtext">
                                @result.RemainingDegreeDays.ToString("0.0")
                                døgngrader står att
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-card">
                            <div class="summary-label">
                                Tid sidan oppheng
                            </div>

                            <div class="summary-value">
                                @result.ElapsedWholeDays døgn
                            </div>

                            <div class="summary-subtext">
                                @result.ElapsedRemainingHours timar og
                                @result.ElapsedRemainingMinutes minutt
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-card">
                            <div class="summary-label">
                                Snittemperatur
                            </div>

                            <div class="summary-value">
                                @if (result.AverageTemperature.HasValue)
                                {
                                    @($"{result.AverageTemperature.Value:0.0} °C")
                                }
                                else
                                {
                                    <span>–</span>
                                }
                            </div>

                            <div class="summary-subtext">
                                For perioden med gyldige målingar
                            </div>
                        </div>
                    </div>
                </div>

                <div class="progress degree-progress mb-3" role="progressbar" aria-label="Framdrift mot valt døgngradmål"
                     aria-valuenow="@progressWidth" aria-valuemin="0" aria-valuemax="100">

                    <div class="progress-bar" style="width: @(progressWidth)%">

                        @result.ProgressPercent.ToString("0") %
                    </div>
                </div>

                @if (result.TargetReached)
                {
                    <div class="alert alert-success mb-4" role="status">

                        <strong>
                            Målet på
                            @result.TargetDegreeDays.ToString("0")
                            døgngrader er nådd.
                        </strong>

                        Kontroller framleis temperatur, lukt, overflate og
                        hygienisk handtering før vidare behandling av kjøtet.
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4" role="status">

                        Det står att

                        <strong>
                            @result.RemainingDegreeDays.ToString("0.0")
                            døgngrader
                        </strong>

                        til målet på
                        @result.TargetDegreeDays.ToString("0").
                    </div>
                }

                @if (result.ExcludedDayCount > 0)
                {
                    <div class="alert alert-warning mb-4" role="alert">

                        Nokre periodar manglar tilstrekkelege
                        temperaturmålingar. Utrekninga kan derfor vere
                        mindre presis.
                    </div>
                }

                <hr class="my-4" />

                <h3 class="h5 mb-3">
                    Detaljar
                </h3>

                <dl class="row result-details mb-0">
                    <dt class="col-sm-5 col-lg-4">
                        Hengt opp
                    </dt>

                    <dd class="col-sm-7 col-lg-8">
                        @result.HungAt.ToString(
                            "dd.MM.yyyy 'kl.' HH:mm")
                    </dd>

                    <dt class="col-sm-5 col-lg-4">
                        Rekna fram til
                    </dt>

                    <dd class="col-sm-7 col-lg-8">
                        @result.CalculatedAt.ToString(
                            "dd.MM.yyyy 'kl.' HH:mm")
                    </dd>

                    <dt class="col-sm-5 col-lg-4">
                        Datakjelde
                    </dt>

                    <dd class="col-sm-7 col-lg-8">
                        @result.SourceName

                        <span class="text-body-secondary">
                            (@result.SourceId)
                        </span>
                    </dd>
                </dl>
            </div>
        </section>

        <section class="card guide-card mb-4" aria-labelledby="daily-values-heading">

            <div class="guide-card-header">
                <h2 id="daily-values-heading" class="h4 mb-1">
                    Døgnverdiar
                </h2>

                <p class="text-body-secondary mb-0">
                    Temperatur og opptente døgngrader per dag.
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-hover day-table mb-0">
                    <caption class="visually-hidden">
                        Døgnverdiar for temperatur og opptente døgngrader.
                    </caption>

                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">
                                Dato og periode
                            </th>

                            <th scope="col" class="text-end">
                                Temperatur
                            </th>

                            <th scope="col" class="text-end">
                                Døgngrader
                            </th>

                            <th scope="col" class="text-end pe-4">
                                Samla
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var day in result.Days)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold">
                                        @day.Date.ToString("dd.MM.yyyy")
                                    </div>

                                    <small class="text-body-secondary">
                                        kl. @day.PeriodStart.ToString("HH:mm")
                                        til @day.PeriodEnd.ToString("HH:mm")
                                    </small>
                                </td>

                                <td class="text-end">
                                    @if (day.MeanTemperature.HasValue)
                                    {
                                        @($"{day.MeanTemperature.Value:0.0} °C")
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">
                                            –
                                        </span>
                                    }
                                </td>

                                <td class="text-end fw-semibold">
                                    @day.DegreeDays.ToString("0.00")
                                </td>

                                <td class="text-end fw-semibold pe-4">
                                    @day.AccumulatedDegreeDays.ToString("0.00")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}