@model VigdalsMorningsguide.Models.FrostWarningModel?

@if (Model is { } warning)
{
    <aside class="alert alert-danger frost-warning mb-4"
           role="alert" aria-labelledby="frost-warning-heading">
        <h2 id="frost-warning-heading" class="h5 fw-bold mb-2">
            ⚠ Frostfare for kjøtet
        </h2>
        <p class="fw-semibold mb-2">
            Pass på kjøtet ditt! Så mørninga ikkje stoppar opp grunna frost!
        </p>
        @if (warning.CurrentTemperatureCelsius is double currentTemperature)
        {
            <p class="mb-2">
                <strong>Minusgrader i skålen:</strong>
                Siste ferske Shelly-måling er
                <strong>@currentTemperature.ToString("0.0") °C</strong>.
            </p>
        }
        @if (warning.FirstForecastBelowZeroAtUtc is DateTimeOffset firstFrost &&
             warning.MinimumForecastTemperatureCelsius is double minimumTemperature)
        {
            var firstFrostLocal = TimeZoneInfo.ConvertTime(
                firstFrost,
                TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo"));

            <p class="mb-1">
                <strong>Minusgrader meldt:</strong>
                YR varslar ned mot
                <strong>@minimumTemperature.ToString("0.0") °C</strong>
                ved @warning.ForecastLocationName innan 48 timar.
            </p>
        }
    </aside>
}
