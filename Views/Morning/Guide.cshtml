@{
    ViewData["Title"] = "Guide til mørning av viltkjøt";
}

<div class="container py-4 py-lg-5">

    <header class="guide-header guide-header-with-antlers mb-4 mb-lg-5">
        <img src="~/images/hjortegevir.webp"
             class="guide-antlers"
             alt=""
             aria-hidden="true"
             asp-append-version="true"/>

        <div class="guide-header-content">
            <h1 class="display-5 fw-bold mb-3">
                Guide for mørning av viltkjøt
            </h1>

            <p class="lead text-body-secondary mb-0">
                Nokre enkle prinsipp for trygg og god mørning
            </p>
        </div>
    </header>

    <section class="card guide-card mb-4">
        <div class="guide-card-header">
            <h2 class="h4 mb-0">
                Mine hovudreglar for god mørning
            </h2>
        </div>
        <div class="guide-card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <h3 class="h5">
                        Hugs på
                    </h3>

                    <ul class="mb-0">
                        <li class="mb-2">
                            Heng kjøtet luftig og tørt. Sørg for god luftsirkulasjon.
                        </li>

                        <li class="mb-2">
                            Unngå for rask nedkjøling rett etter slakting. Hjorteviltportalen advarer mot at slaktet blir kjølt ned til under 12°C før dødsstilvheiten er utvikla. Dette skjer vanlegvis innan 12–24 timar. For rask nedkjøling kan gi kuldeforkorting og seigare kjøt.
                        </li>

                        <li class="mb-2">
                            Hald fluger og insekt vekke frå kjøtet. Det er nok det viktigaste. Bruk gjerne viltsekk rundt kjøtet. Så lenge ein held fluger og innsekt vekke, kan ein dra på med veldig lang mørningstid. Flugeegg klekker i løpet av 24 timar ved 20°C.
                        </li>

                        <li class="mb-2">
                            La slaktet få ei tørr overflate så raskt som råd slik at ein får ei god tørkehinne. Dette får ein ved god sirkulasjon av luft rundt viltet. Dette vil og gi kjøtet god beskyttelse mot fluger og insekt.
                        </li>

                        <li>
                            Hald god hygiene gjennom heile prosessen. Mindre bruk av kniv gir mindre grobunn for bakteriar. Parter dyret så lite som mogeleg før mørning.
                        </li>

                        <li>
                            Ein kan fint partere viltet undervegs i mørninga og la resten av mørninga føregå i kjøleskap i vakumposar etterkvart.
                        </li>
                        
                        <li>
                            Kjøt som skal brukast til oppmaling for kjøtdeig e.l. behøver ikkje mørnast. Det kan skjerast ned og frysast etter eit døgn. Eg pleier skjære ned bog, side og nakke etter eit døgn mørning. Dette er kjøt som normalt sett ikkje treng mørning, då det enten blir kjøtdeig eller langtids-varmebehandla.
                        </li>
                        
                        <li>
                            Ikkje bruk vattn til å vaske kjøtet!
                        </li>
                    </ul>
                </div>

                <div class="col-md-6">
                    <h3 class="h5">
                        Pass på
                    </h3>

                    <ul class="mb-0">
                        <li class="mb-2">
                            Fuktig og stilleståande luft.
                        </li>

                        <li class="mb-2">
                            Unødvendig oppdeling før mørninga.
                        </li>

                        <li class="mb-2">
                            For rask nedkjøling det første døgnet.
                        </li>

                        <li>
                            Slimete eller unormal overflate på kjøtet.
                        </li>
                        <li>
                            Fluger som har lagt egg. Sjå etter egg umiddelbart om ein oppdagar fluger rundt kjøtet.
                        </li>
                    </ul>
                </div>

            </div>

        </div>
    </section>

    <section class="card guide-card mb-4">
        <div class="guide-card-header">
            <h2 class="h4 mb-0">
                Kvifor mørnar me kjøtet?
            </h2>
        </div>

        <div class="guide-card-body">
            <p class="mb-0">
                Mørning gjer først og fremst kjøtet mørare.
                Etter slakting arbeider naturlege enzym i kjøtet
                vidare og bryt gradvis ned strukturar i muskelfibrane.
                Tid og temperatur avgjer kor raskt denne prosessen går.
            </p>
        </div>
    </section>

