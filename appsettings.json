{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Frost": {
    "BaseUrl": "https://frost.met.no/",
    "MinimumCoveragePercent": 70.0,
    "MeasurementIntervalMinutes": 10,
    "MaximumDaysBack": 90
  },

  "MetForecast": {
    "BaseUrl": "https://api.met.no/weatherapi/locationforecast/2.0/",
    "UserAgent": "VigdalsMorningsguide/1.0 (+https://github.com/Vigdals/VigdalsMorningsguide)"
  },

  "Shelly": {
    "DisplayName": "Skålen i Sogndal",
    "CacheSeconds": 30,
    "StaleAfterMinutes": 30,
    "MinimumCoveragePercent": 70.0,
    "MaximumDaysBack": 90
  }
}
